# SPDX-License-Identifier: GPL-3.0-only
# Versions of the tools that the workflows install, kept in one place. Every job that needs
# them appends the NAME=value lines below to $GITHUB_ENV in a step of its own, so that later
# steps read them as env.NAME, also in the inputs of actions. Comment lines are skipped; a
# value must not contain spaces or quotes.
#
# Used by ci.yml (Qt in the platform jobs, Doxygen in the Documentation job), codeql.yml (Qt),
# release.yml (Qt, read from the workflow's own commit) and docs.yml (Doxygen). A change here
# also needs the Qt version of docs/how-to/build-from-source.md and README.md.

# The Qt release installed with aqtinstall (ADR 0003) and shipped in the packages.
QT_VERSION=6.10.3

# Doxygen is pinned because the C++ reference generator reads its XML, whose schema changes
# with the version (ADR 0017). The SHA-256 of the Linux release archive makes a job fail if
# the download ever differs.
DOXYGEN_VERSION=1.18.0
DOXYGEN_SHA256=14fa81bdc34171edb5f1f02b1d60e74802f0439b77fa44e592565d517d72df90
