// Windows resources of the desktop application: icon and version information.
// Generated into the build directory by CMake from nmeasimulatorx.rc.in.
#include <winver.h>

IDI_ICON1 ICON "@NMEASIM_ICONS_DIR@/nmeasimulatorx.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Dimitrios Kafetzis"
            VALUE "FileDescription", "NMEA Simulator X"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "NMEASimulatorX"
            VALUE "LegalCopyright", "Copyright 2026 Dimitrios Kafetzis. GPL-3.0-only."
            VALUE "OriginalFilename", "NMEASimulatorX.exe"
            VALUE "ProductName", "NMEA Simulator X"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
